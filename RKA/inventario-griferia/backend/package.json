{
  "name": "rka-backend",
  "version": "1.0.0",
  "description": "Backend API para RKA - Sistema de Gestión de Inventario",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate:rbac": "node src/scripts/migrate-rbac.js",
    "migrate:passwords": "node src/scripts/migrate-passwords.js",
    "migrate:ventas": "node src/scripts/migrate-ventas.js",
    "migrate:all": "npm run migrate:rbac && npm run migrate:passwords && npm run migrate:ventas"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  }
}
